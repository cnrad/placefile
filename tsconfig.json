{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "bun-types",
      "@cloudflare/workers-types/experimental"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}